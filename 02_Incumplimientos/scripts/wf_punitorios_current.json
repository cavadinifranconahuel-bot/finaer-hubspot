  "name": "WF — Cálculo Punitorios Seguimiento de Deuda",
  "createdAt": "2026-04-30T15:07:59.272Z",
  "updatedAt": "2026-05-12T14:46:51.075Z",
  "startActionId": "2",
  "nextAvailableActionId": "3",
  "actions": [
    {
      "actionId": "2",
      "secretNames": [
        "token"
      ],
      "sourceCode": "const hubspot = require('@hubspot/api-client');\n\nexports.main = async (event, callback) => {\n  const hubspotClient = new hubspot.Client({ accessToken: process.env.token });\n  const dealId = event.object.objectId;\n\n  try {\n    const rawDesembolso  = event.inputFields['fecha_desembolso'];\n    const rawNegociacion = event.inputFields['fecha_negociacion'];\n\n    const fechaInicioMora  = isNaN(rawDesembolso)  ? new Date(rawDesembolso)  : new Date(parseInt(rawDesembolso));\n    const fechaNegociacion = isNaN(rawNegociacion) ? new Date(rawNegociacion) : new Date(parseInt(rawNegociacion));\n\n    fechaInicioMora.setHours(0, 0, 0, 0);\n    fechaNegociacion.setHours(0, 0, 0, 0);\n\n    const daysDiff = Math.max(0, Math.floor((fechaNegociacion - fechaInicioMora) / 86400000));\n\n    const alquiler = parseFloat(event.inputFields['deuda_alquiler'])  || 0;\n    const expensas = parseFloat(event.inputFields['deuda_expensas'])  || 0;\n    const gas      = parseFloat(event.inputFields['deuda_gas'])       || 0;\n    const luz      = parseFloat(event.inputFields['deuda_luz'])       || 0;\n    const abl      = parseFloat(event.inputFields['deuda_abl'])       || 0;\n    const aysa     = parseFloat(event.inputFields['deuda_aysa'])      || 0;\n\n    const punitorioAlquiler  = Math.round(alquiler * 0.005 * daysDiff * 100) / 100;\n    const punitorioServicios = Math.round((expensas + gas + luz + abl + aysa) * 0.001 * daysDiff * 100) / 100;\n    const totalPunitorios    = Math.round((punitorioAlquiler + punitorioServicios) * 100) / 100;\n\n    await hubspotClient.crm.deals.basicApi.update(dealId, {\n      properties: {\n        punitorio_alquiler:  punitorioAlquiler.toString(),\n        punitorio_servicios: punitorioServicios.toString(),\n        total_punitorios:    totalPunitorios.toString()\n      }\n    });\n\n    const assocRes = await hubspotClient.apiRequest({ method: 'GET', path: '/crm/v3/objects/deals/' + dealId + '/associations/tickets' });\n    const assocData = await assocRes.json();\n    if (assocData.results && assocData.results.length > 0) {\n      const ticketId = assocData.results[0].id;\n      await hubspotClient.crm.tickets.basicApi.update(ticketId, {\n        properties: {\n          punitorio_alquiler:  punitorioAlquiler.toString(),\n          punitorio_servicios: punitorioServicios.toString(),\n          total_punitorios:    totalPunitorios.toString()\n        }\n      });\n    }\n\n  } catch(e) { console.error('Error:', e.message); throw e; }\n\n  callback({ outputFields: {} });\n};",
